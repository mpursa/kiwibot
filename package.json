{
	"name": "kiwibot",
	"version": "1.6.1",
	"private": true,
	"description": "Discord bot for starting and stopping game servers via systemd",
	"type": "module",
	"author": {
		"name": "mpursa",
		"email": "m.pretto93@gmail.com",
		"url": "https://github.com/mpursa"
	},
	"license": "BSD-2-Clause",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mpursa/kiwibot.git"
	},
	"engines": {
		"bun": ">=1.4"
	},
	"scripts": {
		"start": "bun run --env-file=.env src/main.ts",
		"watch": "bun --watch src/main.ts",
		"test": "bun test --env-file=.env.test",
		"testCommand": "bun run --env-file=.env.test tests/run-command.ts",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"discord.js": "^14.16.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"prettier": "^3.9.6",
		"typescript": "^5.6.0"
	}
}
